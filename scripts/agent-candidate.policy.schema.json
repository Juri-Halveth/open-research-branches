{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Local agent candidate policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "workspaceRoot",
    "allowedPaths",
    "allowedExtensions",
    "allowNewFiles",
    "maxCandidateBytes",
    "requiredChecks"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "workspaceRoot": { "type": "string", "minLength": 1 },
    "allowedPaths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Za-z0-9._/-]+$" }
    },
    "allowedExtensions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": [".ps1", ".json", ".md"] }
    },
    "allowNewFiles": { "type": "boolean" },
    "maxCandidateBytes": { "type": "integer", "minimum": 1, "maximum": 1048576 },
    "requiredChecks": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "enum": ["UTF8_BYTE_ROUNDTRIP", "GIT_DIFF_CHECK", "TYPE_PARSE", "SINGLE_TARGET"]
      }
    }
  }
}
